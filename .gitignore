# Package & native-comp artifacts
/elpa/
/eln-cache/
/transient/
*.elc

# Tree-sitter grammars (built locally via treesit-install-language-grammar)
/tree-sitter/

# Runtime state — never config
/auto-save-list/
/backups/
/history
/places
/recentf
/.emacs.desktop
/.emacs.desktop.lock
/projectile-bookmarks.eld
/network-security.data
/request/
/url/
/.cache/

# Machine-local customize output (init.el loads it if present)
/custom.el

# Generated by org-babel-load-file from config.org at startup
/config.el
/config.org.backup

# Editor leftovers
*.bak
init.el.bak-*
*~
\#*\#
.\#*

# project.el recent-project list (runtime state)
/projects

# session-layout.el window snapshot (runtime state)
/last-session-layout.el
